{
  "name": "@inrent/services",
  "version": "0.1.0",
  "private": true,
  "description": "Database-backed domain services shared by the web app, gateway and worker.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./payments": "./src/payments/index.ts",
    "./email": "./src/email.ts",
    "./emailTemplates": "./src/emailTemplates.ts",
    "./sms": "./src/sms.ts",
    "./queue": "./src/queue.ts",
    "./redis": "./src/redis.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@inrent/core": "workspace:*",
    "@inrent/db": "workspace:*",
    "@inrent/observability": "workspace:*",
    "@inrent/providers": "workspace:*",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.1",
    "stripe": "^19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@inrent/config": "workspace:*",
    "@types/node": "^22.18.0",
    "vitest": "^4.1.11"
  }
}
