{
  "name": "@inrent/db",
  "version": "0.1.0",
  "private": true,
  "description": "INRENT Prisma schema, client, migrations and seed data.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "init": "prisma migrate deploy && tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma scripts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@inrent/config": "workspace:*",
    "@types/node": "^22.18.0",
    "better-auth": "1.7.7",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "@inrent/core": "workspace:*"
  }
}
