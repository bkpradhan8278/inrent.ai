{
  "name": "@inrent/cli",
  "version": "0.1.0",
  "description": "INRENT command-line interface.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "inrent": "./dist/index.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --banner.js \"#!/usr/bin/env node\"",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@inrent/sdk": "workspace:*",
    "commander": "^14.0.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@inrent/config": "workspace:*",
    "@types/node": "^22.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  },
  "engines": { "node": ">=18" }
}
