{
  "name": "@inrent/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for the INRENT API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@inrent/config": "workspace:*",
    "@types/node": "^22.18.0",
    "tsup": "^8.5.0",
    "vitest": "^4.1.11"
  },
  "engines": { "node": ">=18" },
  "keywords": ["inrent", "ai", "llm", "openai-compatible", "sdk"]
}
