{
  "name": "@inrent/worker",
  "version": "0.1.0",
  "private": true,
  "description": "INRENT background jobs — webhooks, usage rollups, provider health, notifications.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@inrent/core": "workspace:*",
    "@inrent/db": "workspace:*",
    "@inrent/observability": "workspace:*",
    "@inrent/providers": "workspace:*",
    "@inrent/services": "workspace:*",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.1"
  },
  "devDependencies": {
    "@inrent/config": "workspace:*",
    "@types/node": "^22.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15"
  }
}
