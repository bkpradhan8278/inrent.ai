{
  "name": "@inrent/worker",
  "version": "0.1.0",
  "private": true,
  "description": "INRENT background jobs \u2014 webhooks, usage rollups, provider health, notifications.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@inrent/core": "workspace:*",
    "@inrent/db": "workspace:*",
    "@inrent/observability": "workspace:*",
    "@inrent/providers": "workspace:*",
    "@inrent/services": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.1",
    "pino": "^10.1.0",
    "stripe": "^19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@inrent/config": "workspace:*",
    "@types/node": "^22.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15"
  }
}
