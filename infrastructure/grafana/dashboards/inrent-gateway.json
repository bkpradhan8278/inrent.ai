{
  "uid": "inrent-gateway",
  "title": "INRENT Gateway",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": ["inrent"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inrent_requests_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inrent_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(inrent_requests_total[5m])),1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency (non-stream)",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inrent_request_duration_seconds_bucket{stream=\"false\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Gross margin (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(inrent_revenue_nano_usd_total[1h])) - sum(increase(inrent_provider_cost_nano_usd_total[1h]))) / clamp_min(sum(increase(inrent_revenue_nano_usd_total[1h])),1)",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests by provider",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(inrent_requests_total[5m]))",
          "legendFormat": "{{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errors by provider",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, code) (rate(inrent_provider_errors_total[5m]))",
          "legendFormat": "{{provider}} {{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(inrent_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inrent_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Time to first token p50 by provider",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, provider) (rate(inrent_time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Tokens / s",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(inrent_tokens_total[5m]))",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Fallbacks & rate limits",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inrent_fallbacks_total[5m]))",
          "legendFormat": "fallbacks",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (scope) (rate(inrent_rate_limited_total[5m]))",
          "legendFormat": "rate limited {{scope}}",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (reason) (rate(inrent_auth_failures_total[5m]))",
          "legendFormat": "auth failure {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Revenue vs provider cost (USD / hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "inrent-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(inrent_revenue_nano_usd_total[1h])) / 1e9",
          "legendFormat": "revenue",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(inrent_provider_cost_nano_usd_total[1h])) / 1e9",
          "legendFormat": "provider cost",
          "datasource": {
            "type": "prometheus",
            "uid": "inrent-prometheus"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
