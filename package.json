{
  "name": "inrent",
  "private": true,
  "description": "INRENT — one API for every AI model. Gateway, billing, routing and developer platform.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@inrent/web --filter=@inrent/gateway --filter=@inrent/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @inrent/gateway test:integration && pnpm --filter @inrent/services test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @inrent/db generate",
    "db:init": "pnpm --filter @inrent/db run init",
    "db:migrate": "pnpm --filter @inrent/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @inrent/db migrate:dev",
    "db:seed": "pnpm --filter @inrent/db seed",
    "db:studio": "pnpm --filter @inrent/db studio",
    "admin:grant": "pnpm --filter @inrent/db admin:grant",
    "postinstall": "pnpm --filter @inrent/db generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
