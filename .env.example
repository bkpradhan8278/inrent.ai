# ─────────────────────────────────────────────────────────────────────────────
# INRENT environment configuration — template only.
#
# Copy to `.env` for local development:   cp .env.example .env
# NEVER commit `.env` or real secrets. In staging/production, inject these from
# your secret manager (AWS Secrets Manager, GCP Secret Manager, Vault, Doppler…).
# Production refuses to start with missing secrets or values containing
# "change-me" / "dev-only", with the mock provider enabled, or with private
# webhook URLs allowed.
#
# Generate secrets with:  openssl rand -base64 48
# Generate an encryption key with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# development | staging | production | test (controls safety checks; defaults to NODE_ENV)
INRENT_ENV=development
LOG_LEVEL=info
INRENT_VERSION=dev

# ── Database & cache ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://inrent:inrent@localhost:5432/inrent
# Used by `pnpm --filter @inrent/db migrate:check` (schema drift check in CI)
SHADOW_DATABASE_URL=postgresql://inrent:inrent@localhost:5432/inrent_shadow
REDIS_URL=redis://localhost:6379/0
PRISMA_LOG_QUERIES=false

# ── Public URLs ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080/v1
# Server-side URL the web app uses to reach the gateway (internal network in Docker/K8s)
GATEWAY_INTERNAL_URL=http://localhost:8080
APP_VERSION=dev
PORT=3000

# ── Authentication (Better Auth) ─────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-48
# Optional social login — leave empty to hide the buttons
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Platform secrets (required) ──────────────────────────────────────────────
# Pepper for hashing API keys (HMAC-SHA256). Rotating it invalidates all keys.
API_KEY_PEPPER=change-me-at-least-32-characters-long-random-value
# Signs short-lived web → gateway assertions (dashboard playground)
INTERNAL_SERVICE_SECRET=change-me-at-least-32-characters-long-random-value
# AES-256-GCM keyring for BYOK keys, webhook and MCP secrets: "<id>:<base64 32 bytes>[,<id>:<key>…]".
# The first key encrypts; all keys decrypt (add a new key first to rotate).
# The default below is a development-only key; production rejects it.
INRENT_ENCRYPTION_KEYS=dev-only:ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
# Salt for hashing client IPs in logs
IP_HASH_SALT=change-me-random-salt

# ── Pricing & billing policy ─────────────────────────────────────────────────
# Default platform markup applied when an admin publishes a price (percent)
DEFAULT_PLATFORM_MARKUP_PCT=5.5
# Optional fee on BYOK requests (percent of list cost); 0 = free routing for BYOK
BYOK_FEE_PCT=0

# ── Payments (optional — checkout is disabled until configured) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required for Razorpay (INR checkout of USD credits). Set from your treasury/FX policy.
RAZORPAY_USD_INR_RATE=

# ── Email ────────────────────────────────────────────────────────────────────
# console (logs emails — development only) | resend | sendgrid
EMAIL_PROVIDER=console
EMAIL_FROM="INRENT <no-reply@example.com>"
RESEND_API_KEY=
SENDGRID_API_KEY=

# ── Upstream model providers ─────────────────────────────────────────────────
# Platform credentials are referenced from the admin console as "env:NAME" (or a secret-manager
# reference) and are only used for providers whose integration mode and terms permit platform
# serving. Leave empty to run BYOK-only. Never expose these to the browser.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# VLLM_API_KEY=

# Development-only mock provider (deterministic responses, no real model). Rejected in production.
INRENT_ENABLE_MOCK_PROVIDER=true
# Allow webhooks to private/loopback addresses (local testing only). Rejected in production.
ALLOW_PRIVATE_WEBHOOK_URLS=false

# ── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_UPSTREAM_TIMEOUT_MS=120000
GATEWAY_SHUTDOWN_GRACE_MS=10000
GATEWAY_CATALOG_TTL_MS=10000
# Unauthenticated requests per minute per IP
GATEWAY_IP_RPM=1200
# Set to true only behind a trusted proxy/load balancer that sets X-Forwarded-For
TRUST_PROXY=false
# Bearer token for /metrics. Required in production (without it /metrics returns 403); optional elsewhere.
METRICS_TOKEN=

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── FinOps alerts (admin console + worker) ───────────────────────────────────
FINOPS_PROVIDER_DAILY_SPEND_ALERT_USD=500
FINOPS_MIN_MARGIN_PCT=2

# ── Feature flag overrides (optional): INRENT_FLAG_<KEY>=true|false ──────────
# INRENT_FLAG_GPU_CLOUD_ENABLED=false

# Optional local container stack
POSTGRES_PASSWORD=inrent
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
GRAFANA_ADMIN_PASSWORD=dev-only-admin
LITELLM_MASTER_KEY=dev-only-litellm-master-key

# ── Seed (development only) ──────────────────────────────────────────────────
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=inrent-demo-password

# Optional test overrides
TEST_DATABASE_URL=postgresql://inrent:inrent@localhost:5432/inrent_test
TEST_REDIS_URL=redis://localhost:6379/15

# Optional live SDK tests / local snippets (blank means mock-only local usage)
INRENT_API_KEY=
INRENT_LIVE_API_KEY=
INRENT_LIVE_BASE_URL=http://localhost:8080/v1
